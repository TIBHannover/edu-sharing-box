########################################################################################################################
### docker specific
########################################################################################################################
# --- define the docker compose project name
COMPOSE_PROJECT_NAME={{plugin_mongo_service_docker_project_name}}

# --- define the MAIN_PROJECT_DIR
MAIN_PROJECT_DIR={{edu_docker_inst_dir}}

########################################################################################################################
###  define MONGO DATABASE
########################################################################################################################
REPOSITORY_MONGO_DATABASE={{plugin_mongo_database_name | default("repository",true)}}
REPOSITORY_MONGO_USER={{plugin_mongo_database_user | default("repository",true)}}
REPOSITORY_MONGO_PASS={{plugin_mongo_database_pass | default("repository",true)}}

########################################################################################################################
### define REPOSITORY-MONGO-SERVICE
########################################################################################################################
REPOSITORY_MONGO_CONNECTION_STRING="mongodb://{{plugin_mongo_database_user | default('repository',true)}}:{{plugin_mongo_database_pass | default('repository',true)}}@repository-mongo:27017/{{plugin_mongo_database_name | default('repository',true)}}?authSource={{plugin_mongo_database_name | default('repository',true)}}"
