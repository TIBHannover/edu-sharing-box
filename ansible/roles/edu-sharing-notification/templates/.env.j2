########################################################################################################################
### docker specific
########################################################################################################################
# --- define the docker compose project name
COMPOSE_PROJECT_NAME={{notification_service_docker_project_name}}


# --- define the MAIN_PROJECT_DIR
MAIN_PROJECT_DIR={{edu_docker_inst_dir}}

########################################################################################################################
###  define notification service database
########################################################################################################################
NOTIFICATION_SERVICE_DATABASE_NAME={{notification_service.db_name | default("notification",true)}}
NOTIFICATION_SERVICE_DATABASE_USER={{notification_service.db_user | default("notification",true)}}
NOTIFICATION_SERVICE_DATABASE_PASS={{notification_service.db_pass | default("notification",true)}}
########################################################################################################################
### define notification service email
########################################################################################################################
NOTIFICATION_SERVICE_MAIL_SERVER_SMTP_HOST={{ notification_service.mail_smtp_host | default(edu_mail_smtp_server,true) }}
NOTIFICATION_SERVICE_MAIL_SERVER_SMTP_PORT={{ notification_service.mail_smtp_port | default(edu_mail_smtp_port,true) }}
NOTIFICATION_SERVICE_MAIL_SERVER_SMTP_USERNAME={{ notification_service.mail_smtp_username | default(edu_mail_smtp_username,true) }}
NOTIFICATION_SERVICE_MAIL_SERVER_SMTP_PASSWORD={{ notification_service.mail_smtp_password | default(edu_mail_smtp_password,true) }}
NOTIFICATION_SERVICE_MAIL_SERVER_SMTP_AUTH={{ notification_service.mail_smtp_auth | default(edu_mail_smtp_auth | default('false',true),true) }}
NOTIFICATION_SERVICE_MAIL_SERVER_SMTP_STARTTLS_ENABLE={{ notification_service.mail_smtp_starttls_enable | default(edu_mail_smtp_starttls_enable | default('false',true),true) }}
NOTIFICATION_SERVICE_MAIL_FROM={{ notification_service.mail_from | default(edu_mail_smtp_from | default('noreply@twillo.de',true),true) }}
NOTIFICATION_SERVICE_MAIL_REPORT_RECEIVER={{ notification_service.mail_report_address | default(edu_mail_report_receiver | default('noreply@twillo.de',true),true) }}







