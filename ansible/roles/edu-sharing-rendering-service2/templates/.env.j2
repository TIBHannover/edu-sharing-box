RENDERING2_RUSTFS_STORAGE_PORT_HTTP={{esrender2.rustfs_port_http | default("10201",true)}}

########################################################################################################################
###  define MESSAGE QUEUE
########################################################################################################################
RENDERING2_MESSAGE_QUEUE_USER={{esrender2.message_queue_user | default("rendering",true)}}
RENDERING2_MESSAGE_QUEUE_PASSWORD={{esrender2.message_queue_password | default("rendering",true)}}
RENDERING2_MESSAGE_QUEUE_PORT_HTTP={{esrender2.message_queue_port_http | default("10300",true)}}

########################################################################################################################
