########################################################################################################################
### docker specific
########################################################################################################################
# --- define the docker compose project name
COMPOSE_PROJECT_NAME={{rendering_service_2_docker_project_name}}
########################################################################################################################
###  define MONGO DATABASE
########################################################################################################################
# -- define the rendering service 2 database name
RENDERING2_SERVICE_DATABASE_NAME={{esrender2.db_user | default("rendering",true)}}
RENDERING2_SERVICE_DATABASE_USER={{esrender2.db_user | default("rendering",true)}}
RENDERING2_SERVICE_DATABASES_PASS={{esrender2.db_password | default("rendering",true)}}

# define Lumi database name
RENDERING2_LUMI_DATABASE_NAME={{esrender2.lumi_db_name | default("lumi",true)}}
RENDERING2_LUMI_DATABASE_USER={{esrender2.lumi_db_user | default("lumi",true)}}
RENDERING2_LUMI_DATABASE_PASS={{esrender2.lumi_db_password | default("lumi",true)}}

########################################################################################################################
###  define RUSTFS STORAGE
########################################################################################################################
RENDERING2_S3_STORAGE_USER={{esrender2.s3_user | default("rendering2",true)}}
