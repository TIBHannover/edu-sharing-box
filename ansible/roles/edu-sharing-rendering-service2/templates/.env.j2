RENDERING2_SERVICE_PUBLIC_HOST={{esrender2.service_public_host | default(edu_sharing_host | default("repository.127.0.0.1.nip.io",true),true)}}
RENDERING2_SERVICE_PUBLIC_PATH={{esrender2.service_public_path | default("/rendering",true)}}
RENDERING2_SERVICE_PUBLIC_PROTOCOL={{esrender2.service_public_protocol | default(edu_sharing_protocol | default("http",true),true)}}
RENDERING2_SERVICE_PUBLIC_PORT={{esrender2.service_public_port | default(edu_sharing_port | default("80",true),true)}}
REPOSITORY_SERVICE_ADMIN_PASS={{alf_password}}
RENDERING2_SERVICE_ADMIN_PASSWORD={{esrender2.service_admin_password | default("admin",true)}}

########################################################################################################################
###  define ADMIN FRONTEND
########################################################################################################################
RENDERING2_ADMIN_FRONTEND_PORT_HTTP={{esrender2.admin_frontend_port_http | default("10400",true)}}
RENDERING2_ADMIN_FRONTEND_PUBLIC_PATH={{esrender2.admin_frontend_public_path | default("/rendering-admin",true)}}